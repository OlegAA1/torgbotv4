# Generate .env.server locally with: node scripts/init_server_env.mjs
NORTHSTAR_ADMIN_USER=admin
NORTHSTAR_ADMIN_PASSWORD=replace_with_20_or_more_random_characters
NORTHSTAR_AUTOMATION_TOKEN=replace_with_32_or_more_different_random_characters
NORTHSTAR_PUBLIC_ORIGIN=http://localhost:3000
NORTHSTAR_DB_PATH=/data/terminal.sqlite
NORTHSTAR_RUNTIME_DIR=/data/runtime
# Enable only after the installation and data checks. Paper only, no real orders.
NORTHSTAR_AUTOMATION_ENABLED=0
NORTHSTAR_AUTOMATION_SCAN_INTERVAL_SECONDS=900
NORTHSTAR_AUTOMATION_EVALUATION_INTERVAL_SECONDS=60
NORTHSTAR_AUTOMATION_CONCURRENCY=3
ALPHA_VANTAGE_API_KEY=
# Telegram notifications (optional; empty = disabled). Token from @BotFather, chat id from @userinfobot;
# write /start to your bot once, otherwise Telegram will not let it message you.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: Bot API address when api.telegram.org is blocked (your own https:// reverse proxy)
# TELEGRAM_API_BASE_URL=https://
# 1 = send, 0 = silence: READY signals / paper trades (open, close, skipped) / system (start, stop, scan problems)
NORTHSTAR_NOTIFY_SIGNALS=1
NORTHSTAR_NOTIFY_TRADES=1
NORTHSTAR_NOTIFY_ALERTS=1
# Time zone shown in messages (hours from UTC and a label)
NORTHSTAR_NOTIFY_TZ_OFFSET_HOURS=3
NORTHSTAR_NOTIFY_TZ_LABEL=МСК
