{
  "name": "trading-terminal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "build:server": "node scripts/build_server.mjs",
    "start:server": "node scripts/server.mjs",
    "test:server": "node --test tests/server-runtime.test.mjs tests/server-automation.test.mjs",
    "test:server:integration": "node --test tests/server-integration.test.mjs tests/server-telegram.integration.mjs",
    "backup:server": "node scripts/backup_server.mjs",
    "notify:test": "node scripts/telegram_test.mjs",
    "test": "vinext build && node --test tests/*.test.mjs",
    "audit:weekly": "node scripts/audit_confluence.mjs",
    "audit:confluence": "node scripts/audit_confluence.mjs",
    "automation:once": "node scripts/automation_daemon.mjs --once",
    "automation:start": "node scripts/automation_daemon.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "node -r ./scripts/node_userinfo_shim.cjs ./node_modules/drizzle-kit/bin.cjs generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
